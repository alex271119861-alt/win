<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Winance</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
:root {
    --bg-base: #0E0E10;
    --bg-appbar: #16161A;
    --bg-card: #1C1C21;
    --bg-card-hover: #26262C;
    --bg-input: #121215;
    --border: #2A2A30;
    --border-input: #33333A;
    --text-primary: #FFFFFF;
    --text-secondary: #9E9EA7;
    --text-muted: #5E5E66;
    --accent: #1BADFF;
    --accent-hover: #45C1FF;
    --success: #71CC52;
    --danger: #F33F3F;
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-pill: 9999px;
    --shadow-card: 0 4px 20px rgba(0,0,0,0.4);
    --shadow-accent: 0 4px 16px rgba(27,173,255,0.25);
}
*, *:before, *:after { box-sizing: border-box; }
* { margin: 0; padding: 0; }
html { -webkit-text-size-adjust: 100%; -webkit-tap-highlight-color: transparent; }
body {
    min-height: 100svh;
    font-family: 'Roboto', -apple-system, 'Segoe UI', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-primary);
    background: var(--bg-base);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 12px;
}
button { cursor: pointer; font: inherit; color: inherit; background: 0 0; border: 0; }
input { font: inherit; color: inherit; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; }
h1, h2, h3, h4 { font-size: inherit; font-weight: inherit; }

/* ===== КОНТЕЙНЕР ===== */
.app {
    width: 100%;
    max-width: 440px;
    background: var(--bg-base);
    border-radius: var(--radius-lg);
    padding: 16px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    min-height: 640px;
    position: relative;
    overflow: hidden;
}

/* ===== APP BAR ===== */
.appbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
}
.appbar-logo {
    width: 32px; height: 32px;
    background: var(--accent);
    color: #fff;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 18px;
    flex-shrink: 0;
    box-shadow: var(--shadow-accent);
}
.appbar-title { font-size: 18px; font-weight: 700; letter-spacing: -0.3px; }
.appbar-sub { font-size: 11px; color: var(--text-secondary); margin-top: 1px; text-transform: uppercase; letter-spacing: 1px; }

/* ===== ГЛАВНАЯ (Терминал) ===== */
.ticker {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    padding: 12px;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--border);
}
.ticker-pair { font-size: 16px; font-weight: 700; }
.ticker-price { font-size: 24px; font-weight: 700; color: var(--success); margin-top: 2px; }
.ticker-change { font-size: 12px; color: var(--success); font-weight: 500; }
.ticker-chart {
    width: 100px;
    height: 40px;
    background: linear-gradient(180deg, rgba(113,204,82,0.2) 0%, rgba(113,204,82,0) 100%);
    border-bottom: 2px solid var(--success);
    position: relative;
    clip-path: polygon(0 80%, 20% 60%, 40% 70%, 60% 30%, 80% 40%, 100% 10%, 100% 100%, 0 100%);
}

.menu {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
}
.menu-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 500;
    transition: background .15s;
    text-align: left;
    width: 100%;
}
.menu-item:hover { background: var(--bg-card-hover); }
.menu-item .icon {
    width: 28px; height: 28px;
    border-radius: 6px;
    background: rgba(27,173,255,0.1);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    color: var(--accent);
}
.menu-item .icon svg { width: 16px; height: 16px; }
.menu-item .arrow { margin-left: auto; color: var(--text-muted); font-size: 18px; }

/* ===== КНОПКИ ===== */
.btn-primary {
    width: 100%;
    padding: 14px;
    background: var(--accent);
    color: #fff;
    border-radius: var(--radius-md);
    font-size: 15px;
    font-weight: 600;
    transition: background .15s, transform .1s;
    box-shadow: var(--shadow-accent);
}
.btn-primary:hover:not(:disabled) { background: var(--accent-hover); }
.btn-primary:disabled { opacity: 0.5; cursor: not-allowed; }

.btn-back {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 500;
    transition: background .15s, color .15s;
    margin-top: 12px;
}
.btn-back:hover { background: var(--bg-card); color: var(--text-primary); }

/* ===== ФОРМЫ ===== */
.form-group { margin-bottom: 14px; }
.form-group label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 6px;
}
.form-group input {
    width: 100%;
    padding: 12px 14px;
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-md);
    font-size: 15px;
    color: var(--text-primary);
    transition: border-color .15s;
}
.form-group input::placeholder { color: var(--text-muted); }
.form-group input:focus { outline: none; border-color: var(--accent); }
.form-group input:disabled { opacity: 0.5; cursor: not-allowed; }

/* ===== СТРАНИЦЫ ===== */
.page { display: none; flex-direction: column; animation: fadeIn .2s ease; flex: 1; }
.page.active { display: flex; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

.page-title {
    font-size: 22px;
    font-weight: 700;
    text-align: center;
    margin-bottom: 4px;
}
.page-sub {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 20px;
}
.page-icon {
    width: 48px; height: 48px;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: rgba(27,173,255,0.1);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent);
}
.page-icon svg { width: 24px; height: 24px; }

/* ===== КАРТОЧКИ ===== */
.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 14px;
    margin-bottom: 10px;
}
.card h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.card p { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }

.faq-item {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    margin-bottom: 8px;
}
.faq-item .q { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
.faq-item .a { font-size: 13px; color: var(--text-secondary); }

/* ===== КОД ===== */
.code-section {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 16px;
    margin-bottom: 16px;
}
.code-section label {
    display: block;
    font-size: 12px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 8px;
    text-align: center;
}
.code-section input {
    width: 100%;
    padding: 14px;
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-md);
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 12px;
    letter-spacing: 6px;
    text-align: center;
    font-weight: 600;
}
.code-section input::placeholder { letter-spacing: normal; font-weight: 400; color: var(--text-muted); }
.code-section input:focus { outline: none; border-color: var(--accent); }

/* ===== СООБЩЕНИЯ ===== */
.message {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: var(--radius-md);
    display: none;
    text-align: center;
    font-size: 13px;
    font-weight: 500;
}
.message.success { display: block; background: rgba(113,204,82,0.1); color: var(--success); border: 1px solid rgba(113,204,82,0.2); }
.message.error { display: block; background: rgba(243,63,63,0.1); color: var(--danger); border: 1px solid rgba(243,63,63,0.2); }
.message.info { display: block; background: rgba(27,173,255,0.1); color: var(--accent); border: 1px solid rgba(27,173,255,0.2); }

.status-waiting {
    margin-top: 12px;
    padding: 12px;
    background: var(--bg-card);
    border-radius: var(--radius-md);
    text-align: center;
    color: var(--accent);
    font-size: 13px;
    display: none;
}
.status-waiting .spinner {
    display: inline-block;
    width: 14px; height: 14px;
    border: 2px solid rgba(27,173,255,0.2);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin .8s linear infinite;
    margin-right: 6px;
    vertical-align: middle;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== ОШИБКА ===== */
.error-page { text-align: center; padding: 30px 0; }
.error-page .icon {
    width: 64px; height: 64px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: rgba(243,63,63,0.1);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; color: var(--danger);
}
.error-page h2 { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.error-page p { font-size: 14px; color: var(--text-secondary); margin-bottom: 20px; }

/* ===== ФУТЕР ===== */
.footer { margin-top: auto; padding-top: 16px; }
.support-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-size: 13px;
    font-weight: 500;
    transition: all .15s;
}
.support-btn:hover { background: var(--bg-card); color: var(--text-primary); }

.register-link {
    text-align: center;
    font-size: 13px;
    color: var(--text-secondary);
    margin-top: 14px;
}
.register-link a { color: var(--accent); font-weight: 500; }
</style>
</head>
<body>

<div class="app">

    <div class="appbar">
        <div class="appbar-logo">W</div>
        <div>
            <div class="appbar-title">Winance</div>
            <div class="appbar-sub">Exchange</div>
        </div>
    </div>

    <!-- ============ ГЛАВНАЯ ============ -->
    <div id="pageMain" class="page active">
        <div class="ticker">
            <div>
                <div class="ticker-pair">ERUB / USDT</div>
                <div class="ticker-price">0.045000</div>
                <div class="ticker-change">+2.34%</div>
            </div>
